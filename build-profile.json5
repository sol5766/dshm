{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "<由 DevEco 自动签名生成，见 README 构建一节>",
          "keyAlias": "debugKey",
          "keyPassword": "<同上，不要提交真实值>",
          "profile": "<同上>",
          "signAlg": "SHA256withECDSA",
          "storeFile": "<同上>",
          "storePassword": "<同上，不要提交真实值>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        // 【签名】本仓库**不含**签名材料（密钥库口令、证书路径均为个人机器绑定）。
        // 用 DevEco Studio 打开本工程 → File > Project Structure > Signing Configs，
        // 勾选 "Automatically generate signature" 即可生成本机可用的签名配置。
        // 生成后不要提交 build-profile.json5 里的真实值 —— 见 .gitignore 里的 build-profile.local.json5。
        "bundleName": "com.dshm.dshclient",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "connection",
      "srcPath": "./connection",
      "targets": [
        {
          "name": "default"
        }
      ]
    },
    {
      "name": "appstate",
      "srcPath": "./appstate",
      "targets": [
        {
          "name": "default"
        }
      ]
    },
    {
      "name": "dshcompat",
      "srcPath": "./dshcompat",
      "targets": [
        {
          "name": "default"
        }
      ]
    },
    {
      "name": "platform",
      "srcPath": "./platform",
      "targets": [
        {
          "name": "default"
        }
      ]
    },
    {
      "name": "hostruntime",
      "srcPath": "./hostruntime",
      "targets": [
        {
          "name": "default"
        }
      ]
    }
  ]
}