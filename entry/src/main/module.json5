{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "srcEntry": "./ets/abilitystage/AppAbilityStage.ets",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:perm_internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:perm_network_info_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:perm_keep_background_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        /*
         * 【现在谁在用】`BackGroundAbility.onPrepareToTerminate()`（托盘后台进程被系统结束
         * 时把事件送回主 Ability 做收尾）。**EntryAbility 已不再实现该回调** ——
         * 2026-10-05 起系统「关闭窗口」回到官方行为（= 退出应用），不再拦成"最小化到后台"。
         *
         * 该权限在 SDK 权限表里是 `availableLevel: "normal"` + `grantMode: "system_grant"`
         * ⇒ 普通应用可声明，安装时自动授予，无运行时弹窗。声明仍在是因为下面那个回调需要它：
         * 不声明时系统**不会调用** `onPrepareToTerminate`，失败形态是「事件永远不来」，
         * 看起来像"这段逻辑没写"而不像"权限没声明"。
         *
         * 【不能与 windowStageClose 同时用】SDK 明确：
         * 「若应用注册了 `windowStageClose` 监听，本回调**不会执行**」。
         * 本工程刻意**不**注册那个监听。
         */
        "name": "ohos.permission.PREPARE_APP_TERMINATE",
        "reason": "$string:perm_prepare_terminate_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.ALLOW_EXTERNAL_NATIVE_CODE",
        "reason": "$string:perm_external_native_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST",
        "reason": "$string:perm_file_access_persist_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.STORE_PERSISTENT_DATA",
        "reason": "$string:perm_store_persist_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_USER_FILE",
        "reason": "$string:perm_user_file_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACCESS_USER_FULL_DISK",
        "reason": "$string:perm_full_disk_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.CUSTOM_SANDBOX",
        "reason": "$string:perm_custom_sandbox_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        // 语音输入（实验）：官方语音 UI 走浏览器 `navigator.mediaDevices.getUserMedia`，
        // 录音发生在**内嵌 Web 组件**里，所以除了这里声明，还必须在 `Web()` 上挂
        // `onPermissionRequest` 把 AUDIO_CAPTURE 放行（两件事缺一不可）：
        //   ① 声明了但没挂回调 ⇒ WebView 一律 deny()，网页侧拿不到麦克风；
        //   ② 挂了回调但没声明 ⇒ 系统层没有该权限，回调放行也会在底层失败。
        // 该权限是 `user_grant`/`NORMAL`（非 system 权限），普通应用走运行时弹窗即可。
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:perm_microphone_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "launchType": "specified",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        /*
         * 【长时任务类型声明 —— 这是 `startBackgroundRunning` 能成功的前提】
         *
         * 实测（2026-09-29，2in1 / MateBook 14）：不声明本字段时
         * `backgroundTaskManager.startBackgroundRunning` 直接失败
         * （`platform/keepalive: startBackgroundRunning failed`），
         * 光有 `ohos.permission.KEEP_BACKGROUND_RUNNING` **不够**。
         *
         * 取值取自 SDK 的 module schema（`toolchains/modulecheck/module.json`）：
         * `enum: [dataTransfer, audioPlayback, audioRecording, location,
         *         bluetoothInteraction, multiDeviceConnection, wifiInteraction, ...]`
         *
         * 为什么选 `dataTransfer`：本应用在后台做的是维持与 Host 的长连接、
         * 收发会话数据 —— 语义上就是数据传输。用 audioPlayback 之类去骗保活
         * 属于滥用系统能力（通知栏会显示"正在播放"），会被审核拒绝。
         *
         * 为什么它是必须的：没有它，`onPrepareToTerminate` 的"关闭=切后台"
         * 只是把窗口收起来 —— 进程随即被挂起，连接断、任务停，
         * 与"关掉别停任务"的诉求相反。
         */
        "backgroundModes": [
          "dataTransfer"
        ],
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        /*
         * 托盘常驻后台 Ability（无窗口、无界面）。
         *
         * 【它是什么】由 EntryAbility 用
         *   processMode        = NEW_PROCESS_ATTACH_TO_STATUS_BAR_ITEM
         *   startupVisibility  = STARTUP_HIDE
         * 拉起的独立进程，唯一职责是把本进程挂到系统托盘的图标上 —— 这是
         * HarmonyOS PC 允许应用在窗口隐藏后继续后台运行的官方做法
         * （官方《PC应用通过系统托盘后台保活》第 2 步）。
         *
         * 【不写 launchType】保持默认 singleton：本 Ability 只该有一个实例，
         * 每多一个就多一个挂在托盘上的进程。specified 会按 key 造实例，正相反。
         *
         * 【不写 skills】它不能出现在桌面图标/启动器里 —— 那是 EntryAbility 的角色。
         * STARTUP_HIDE 只管「启动时不显示窗口、不进 Dock」，管不住启动器条目。
         *
         * 【不写 backgroundModes】它的保活方式就是「贴住托盘图标」本身，
         * 不申请长时任务（长时任务由 EntryAbility 侧统一申请，见 KeepAlive）。
         */
        "name": "BackGroundAbility",
        "srcEntry": "./ets/backgroundability/BackGroundAbility.ets",
        "description": "$string:BackgroundAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:BackgroundAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}